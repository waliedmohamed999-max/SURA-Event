// Global Village Bahrain — Shop Leasing Platform
// Prisma schema. Map geometry (ShopGeometry) is kept deliberately separate from
// business data (Shop) so the map editor can move/resize shapes without touching
// pricing, status, or application history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ShopStatus {
  available
  application_pending
  under_review
  approved
  rented
  reserved
  unavailable
}

enum ApplicationStatus {
  new
  under_review
  documents_required
  approved
  rejected
  cancelled
  rented
}

enum AdminRole {
  super_admin
  manager
  leasing_officer
  viewer
}

enum DocumentType {
  commercial_registration
  brand_profile
  product_catalog
  identity_document
  other
}

enum RentalStatus {
  active
  completed
  terminated
}

// ---------------------------------------------------------------------------
// Catalog / configuration (admin-editable, never hard-coded in UI)
// ---------------------------------------------------------------------------

model Category {
  id           String   @id @default(cuid())
  key          String   @unique
  nameEn       String
  nameAr       String
  descriptionEn String?
  descriptionAr String?
  icon         String?
  colorHex     String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shops Shop[]

  @@map("categories")
}

model StatusConfig {
  id        String   @id @default(cuid())
  key       String   @unique // matches ShopStatus enum value
  labelEn   String
  labelAr   String
  colorHex  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("status_config")
}

// ---------------------------------------------------------------------------
// Shops & map geometry
// ---------------------------------------------------------------------------

model Shop {
  id           String     @id @default(cuid())
  shopNumber   String     @unique
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  area         Float?
  width        Float?
  height       Float?
  location     String? // free-text zone description, e.g. "Left wing, near entrance"
  status       ShopStatus @default(available)
  rentalPrice  Float?
  rentalPeriod String?
  description  String?
  images       String[]  @default([])
  isDemoData   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  geometry     ShopGeometry?
  applications Application[]
  rentals      Rental[]
  auditLogs    AuditLog[]

  @@map("shops")
}

model ShopGeometry {
  id            String   @id @default(cuid())
  shopId        String   @unique
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  polygonPoints Json // [[x,y], [x,y], ...] in the map's local coordinate space
  centerPoint   Json // {x, y}
  labelPosition Json // {x, y}
  rotation      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("shop_geometry")
}

// ---------------------------------------------------------------------------
// Applicants & applications
// ---------------------------------------------------------------------------

model Applicant {
  id          String   @id @default(cuid())
  fullName    String
  companyName String?
  email       String
  mobile      String
  country     String
  city        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]

  @@map("applicants")
}

model Application {
  id                     String            @id @default(cuid())
  applicationNumber      String            @unique
  applicantId            String
  applicant              Applicant         @relation(fields: [applicantId], references: [id])
  shopId                 String
  shop                   Shop              @relation(fields: [shopId], references: [id])

  // Business information
  businessActivity       String
  brandCategory           String?
  yearsInBusiness         Int?
  website                 String?
  instagram               String?
  crNumber                String?

  // Shop requirements
  preferredRentalPeriod   String?
  staffCount               Int?
  additionalRequirements   String?

  agreedToTerms            Boolean           @default(false)
  status                   ApplicationStatus @default(new)
  assignedEmployeeId       String?
  assignedEmployee         AdminUser?        @relation(fields: [assignedEmployeeId], references: [id])
  internalNotes            String?

  submittedAt              DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  documents  Document[]
  rentals    Rental[]
  auditLogs  AuditLog[]

  @@index([shopId])
  @@index([status])
  @@map("applications")
}

model Document {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocumentType
  storageKey    String
  fileName      String
  fileSize      Int
  mimeType      String
  uploadedAt    DateTime     @default(now())

  @@map("documents")
}

// ---------------------------------------------------------------------------
// Rentals (kept as history even after a shop becomes available again)
// ---------------------------------------------------------------------------

model Rental {
  id            String       @id @default(cuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id])
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id])
  tenantName    String
  companyName   String?
  startDate     DateTime?
  endDate       DateTime?
  status        RentalStatus @default(active)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([shopId])
  @@map("rentals")
}

// ---------------------------------------------------------------------------
// Admin users & audit log
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(viewer)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedApplications Application[]
  auditLogs            AuditLog[]
  sessions             Session[]

  @@map("admin_users")
}

model Session {
  id          String    @id @default(cuid())
  token       String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@map("sessions")
}

model AuditLog {
  id             String     @id @default(cuid())
  actorId        String?
  actor          AdminUser? @relation(fields: [actorId], references: [id])
  action         String
  entityType     String
  entityId       String
  shopId         String?
  shop           Shop?      @relation(fields: [shopId], references: [id])
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id])
  previousValue  String?
  newValue       String?
  notes          String?
  createdAt      DateTime   @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
